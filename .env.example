MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 Storage
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=onivaco
CLOUDFLARE_R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_CDN_URL="https://cdn.your-domain.com"
CLOUDFLARE_R2_REGION=auto

# Upload Limits
UPLOAD_MAX_FILE_SIZE=5120

VITE_APP_NAME="${APP_NAME}"

STATE_MACHINE_ROLLOUT_MODE=dual
STATE_MACHINE_ORDER_ENABLED=false
STATE_MACHINE_INVOICE_ENABLED=false
STATE_MACHINE_RETURN_ORDER_ENABLED=false
STATE_MACHINE_IMPORT_RECEIPT_ENABLED=false
STATE_MACHINE_STOCK_TAKE_ENABLED=false

DOMAIN_SERVICE_ORDER_ENABLED=true
DOMAIN_SERVICE_INVOICE_ENABLED=false
DOMAIN_SERVICE_INVENTORY_ENABLED=false

STATE_MACHINE_AUDIT_ENABLED=true
STATE_MACHINE_AUDIT_CHANNEL=stack